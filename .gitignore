# Secrets — never commit these.
#
# google-services.json contains project identifiers and the OAuth client
# configuration. firebase_options.dart is generated from it. Both are
# reproducible with `flutterfire configure`, so keeping them out of the
# repository costs nothing and avoids publishing project config.
**/android/app/google-services.json
lib/firebase_options.dart
.env
*.env

# Firebase emulator
.firebase/
firestore-debug.log
ui-debug.log
firebase-debug.log

# Admin tooling — the service-account key bypasses every security rule.
tools/admin/node_modules/
tools/admin/serviceAccount*.json
tools/admin/content/
